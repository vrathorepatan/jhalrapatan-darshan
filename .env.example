# ────────────────────────────────────────────────────
# Web App (apps/web/.env.local)
# ────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://user:password@host:5432/jhalrapatan_darshan

# Site
NEXT_PUBLIC_SITE_URL=https://jhalrapatandarshan.in
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx

# Admin
ADMIN_PASSWORD_HASH=   # bcrypt/argon2 hash of admin password
SESSION_SECRET=        # 32+ char random secret for session cookies

# Cron (used by external scheduler hitting /api/cron/*)
CRON_SECRET=           # Bearer token for cron endpoints

# Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jhalrapatandarshan.in

# Telegram Bot
TELEGRAM_BOT_TOKEN=    # From @BotFather
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321  # Comma-separated Telegram user IDs
TELEGRAM_WEBHOOK_SECRET=  # Secret for webhook validation

# ────────────────────────────────────────────────────
# Stream Controller (apps/stream-controller/.env)
# ────────────────────────────────────────────────────

# Camera
CAMERA_URL=rtsp://admin:password@192.168.1.100:554/stream

# YouTube RTMP
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# Facebook RTMP
FACEBOOK_RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp
FACEBOOK_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# YouTube API (OAuth)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Facebook API
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=   # Long-lived page access token

# Web App communication
WEB_API_URL=https://jhalrapatandarshan.in
STREAM_CONTROLLER_TOKEN=      # Bearer token for /api/stream/heartbeat

# Encoding
VIDEO_BITRATE_KBPS=2800
ALWAYS_ON=true
TZ=Asia/Kolkata
