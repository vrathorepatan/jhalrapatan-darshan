# ────────────────────────────────────────────────────────────
# Jhalrapatan Darshan – Temple Stream Controller Configuration
# ────────────────────────────────────────────────────────────

# RTSP/RTMP camera stream from temple IP camera
CAMERA_URL=rtsp://admin:camera_pass_here@192.168.1.100:554/h264Preview_01_main

# Target video bitrate in kbps (2800 recommended for 720p/1080p temple video)
VIDEO_BITRATE_KBPS=2800

# 24x7 ingest flag:
# true  -> FFmpeg runs constantly to ingest server, visibility toggled via API (recommended)
# false -> FFmpeg starts 2 minutes before darshan, stops after (bandwidth saver)
ALWAYS_ON=true

# YouTube RTMP Ingest & Stream Key
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# YouTube API Automation credentials
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_client_secret
YOUTUBE_REFRESH_TOKEN=1//04your_refresh_token
YOUTUBE_PERSISTENT_STREAM_ID=your_persistent_stream_id

# Facebook RTMP Ingest & Page Live API (Optional)
FACEBOOK_RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp/
FACEBOOK_STREAM_KEY=FB-xxxx-xxxx
FACEBOOK_PAGE_ID=1234567890
FACEBOOK_PAGE_ACCESS_TOKEN=EAAxxxxxxxxx

# Web Application API & Security Token
WEB_API_URL=https://darshan.jhalrapatan.org
STREAM_CONTROLLER_TOKEN=your_secure_bearer_token_here
TZ=Asia/Kolkata
